# Notion Configuration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# Trilium Configuration
# Your Trilium server URL (e.g., http://localhost:8080 or https://your-trilium-server.com)
TRILIUM_URL=http://localhost:8080

# Get your ETAPI token from Trilium: Options -> ETAPI
TRILIUM_TOKEN=your_trilium_etapi_token_here

# Optional: Parent note ID in Trilium where imported notes will be created
# If not specified or set to 'root', a "Notion Import (YYYY-MM-DD)" folder will be created automatically
# Can also be specified via CLI: --trilium-parent-id <id>
# TRILIUM_PARENT_NOTE_ID=root

# Import Options (now available as CLI arguments)
# Use --help to see all available options:
#   --root-page-id <id>        Notion root page ID to start import from
#   --trilium-parent-id <id>   Trilium parent note ID for imported notes
#   --dry-run                  Preview import without making changes
#   --structure-only           Only create note structure (no content)
#   --log-level <level>        Set log level (debug, info, warn, error)
