# Notion Configuration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# Optional: Specify a root page ID to import only a specific page and its children
# Leave empty to import all accessible pages
# NOTION_ROOT_PAGE_ID=

# Trilium Configuration
# Your Trilium server URL (e.g., http://localhost:8080 or https://your-trilium-server.com)
TRILIUM_URL=http://localhost:8080

# Get your ETAPI token from Trilium: Options -> ETAPI
TRILIUM_TOKEN=your_trilium_etapi_token_here

# Optional: Parent note ID in Trilium where imported notes will be created
# Leave empty to create under root
# TRILIUM_PARENT_NOTE_ID=root

# Import Options
# Set to 'true' to preview what will be imported without making changes
DRY_RUN=false

# Set to 'true' to only create the directory structure (Phase 1 & 2), then stop
# This lets you verify the hierarchy in Trilium before filling in content
STRUCTURE_ONLY=false

# Log level: debug, info, warn, error
LOG_LEVEL=info
