{
  "name": "notion-to-trilium",
  "version": "1.0.0",
  "description": "Fetch all your Notion notes and move them to your trilium note instance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "notion-to-trilium": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "notion",
    "trilium",
    "migration",
    "import",
    "notes"
  ],
  "author": "Florian Fackler<github@lale.li>",
  "license": "ISC",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
